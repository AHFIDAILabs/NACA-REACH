# =============================================================================
# NACA AI HIV Chatbot — Environment Configuration Template
# =============================================================================
# Copy to .env.local for development: cp .env.example .env.local
# In GKE: secrets injected via Workload Identity + Secret Manager
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NACA_ENVIRONMENT=development
NACA_DEBUG=true
NACA_LOG_LEVEL=DEBUG
NACA_HOST=0.0.0.0
NACA_PORT=8000

# ── Database (Cloud SQL for PostgreSQL) ──────────────────────────────────────
NACA_DATABASE_URL=postgresql+asyncpg://naca:naca_dev@localhost:5432/naca_chatbot
NACA_DATABASE_POOL_SIZE=10
NACA_DATABASE_MAX_OVERFLOW=5

# ── Redis (Memorystore) ─────────────────────────────────────────────────────
NACA_REDIS_URL=redis://localhost:6379/0
NACA_SESSION_TTL_SECONDS=1800

# ── Anthropic Claude API ────────────────────────────────────────────────────
NACA_ANTHROPIC_API_KEY=sk-ant-xxxx
NACA_CLAUDE_SONNET_MODEL=claude-sonnet-4-6
NACA_CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
NACA_LLM_TEMPERATURE=0.3
NACA_LLM_MAX_OUTPUT_TOKENS=800

# ── Google Cloud ────────────────────────────────────────────────────────────
NACA_GCP_PROJECT_ID=naca-chatbot-dev
NACA_GCP_REGION=africa-south1

# ── Google Cloud Translation ────────────────────────────────────────────────
NACA_TRANSLATION_ENABLED=true
NACA_HAUSA_DIRECT_LLM=false

# ── Vector Database (Qdrant) ────────────────────────────────────────────────
NACA_VECTOR_DB_TYPE=qdrant
NACA_QDRANT_URL=http://localhost:6333
NACA_QDRANT_COLLECTION=naca_knowledge_base
NACA_RETRIEVAL_TOP_K=5

# ── WhatsApp Business API ───────────────────────────────────────────────────
NACA_WHATSAPP_API_URL=https://graph.facebook.com/v18.0
NACA_WHATSAPP_PHONE_NUMBER_ID=
NACA_WHATSAPP_BUSINESS_ACCOUNT_ID=
NACA_WHATSAPP_API_TOKEN=
NACA_WHATSAPP_VERIFY_TOKEN=
NACA_WHATSAPP_APP_SECRET=

# ── Telegram Bot API ────────────────────────────────────────────────────────
NACA_TELEGRAM_BOT_TOKEN=
NACA_TELEGRAM_WEBHOOK_SECRET=

# ── Google Maps ─────────────────────────────────────────────────────────────
NACA_GOOGLE_MAPS_API_KEY=
NACA_REFERRAL_DEFAULT_RADIUS_KM=25
NACA_REFERRAL_MAX_RADIUS_KM=100

# ── Escalation / PagerDuty ──────────────────────────────────────────────────
NACA_PAGERDUTY_INTEGRATION_KEY=

# ── Security ────────────────────────────────────────────────────────────────
NACA_JWT_SECRET_KEY=change-me-in-production
NACA_INTERNAL_SERVICE_TOKEN=change-me-in-production
NACA_CORS_ORIGINS=["http://localhost:3000"]

# ── Analytics (BigQuery) ────────────────────────────────────────────────────
NACA_BIGQUERY_DATASET=naca_chatbot_analytics
NACA_BIGQUERY_EVENTS_TABLE=interaction_events
